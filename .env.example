# cp 呢個做 .env（已經 gitignore），填返實際值。唔好將呢個檔改名做 .env 之後 commit。

# 條款抽取用（packages/agent1-base，Phase 2 先用到）
ANTHROPIC_API_KEY=

# fetch() 嘅 js render_mode（Cloudflare Browser Rendering API）
# Account ID：Cloudflare dashboard 右手邊 / Workers & Pages 頁
# API Token：My Profile → API Tokens → Create Token → Custom Token
#            → Account: Browser Rendering: Edit
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
