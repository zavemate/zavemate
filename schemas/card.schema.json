{
  "$ref": "#/definitions/Card",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Card": {
      "additionalProperties": false,
      "properties": {
        "active": {
          "default": true,
          "type": "boolean"
        },
        "annual_fee": {
          "minimum": 0,
          "type": "number"
        },
        "annual_fee_waiver_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "card_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_]*$",
          "type": "string"
        },
        "card_name": {
          "minLength": 1,
          "type": "string"
        },
        "card_name_zh": {
          "type": [
            "string",
            "null"
          ]
        },
        "eligibility": {
          "additionalProperties": false,
          "properties": {
            "min_relationship_balance": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "min_relationship_balance",
            "note"
          ],
          "type": "object"
        },
        "fx_fee_rate": {
          "type": [
            "number",
            "null"
          ]
        },
        "issuer": {
          "minLength": 1,
          "type": "string"
        },
        "network": {
          "enum": [
            "visa",
            "mastercard",
            "amex",
            "unionpay",
            "jcb"
          ],
          "type": "string"
        },
        "provenance": {
          "$ref": "#/definitions/Card/properties/rewards/items/properties/provenance"
        },
        "rewards": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "cap": {
                "anyOf": [
                  {
                    "additionalProperties": false,
                    "properties": {
                      "period": {
                        "enum": [
                          "transaction",
                          "month",
                          "quarter",
                          "year",
                          "promo_period"
                        ],
                        "type": "string"
                      },
                      "pool_id": {
                        "$ref": "#/definitions/Card/properties/card_id"
                      },
                      "shared_with": {
                        "default": [],
                        "items": {
                          "$ref": "#/definitions/Card/properties/card_id"
                        },
                        "type": "array"
                      },
                      "unit": {
                        "enum": [
                          "reward",
                          "spend"
                        ],
                        "type": "string"
                      },
                      "value": {
                        "exclusiveMinimum": 0,
                        "type": "number"
                      }
                    },
                    "required": [
                      "pool_id",
                      "value",
                      "unit",
                      "period"
                    ],
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "effective_from": {
                "anyOf": [
                  {
                    "format": "date",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "effective_to": {
                "anyOf": [
                  {
                    "format": "date",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "label": {
                "minLength": 1,
                "type": "string"
              },
              "match": {
                "additionalProperties": false,
                "properties": {
                  "channel": {
                    "anyOf": [
                      {
                        "items": {
                          "enum": [
                            "online",
                            "offline",
                            "mobile_pay",
                            "recurring"
                          ],
                          "type": "string"
                        },
                        "type": "array"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "currency": {
                    "anyOf": [
                      {
                        "items": {
                          "enum": [
                            "HKD",
                            "FOREIGN"
                          ],
                          "type": "string"
                        },
                        "type": "array"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "mcc_exclude": {
                    "anyOf": [
                      {
                        "items": {
                          "pattern": "^\\d{4}$",
                          "type": "string"
                        },
                        "type": "array"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "mcc_include": {
                    "anyOf": [
                      {
                        "items": {
                          "pattern": "^\\d{4}$",
                          "type": "string"
                        },
                        "type": "array"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "merchant_exclude": {
                    "anyOf": [
                      {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "merchant_include": {
                    "anyOf": [
                      {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "min_spend_per_txn": {
                    "anyOf": [
                      {
                        "minimum": 0,
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "channel",
                  "currency",
                  "mcc_include",
                  "mcc_exclude",
                  "merchant_include",
                  "merchant_exclude",
                  "min_spend_per_txn"
                ],
                "type": "object"
              },
              "provenance": {
                "additionalProperties": false,
                "properties": {
                  "check_fail_count": {
                    "default": 0,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "confidence": {
                    "enum": [
                      "official",
                      "crowdsourced",
                      "unconfirmed"
                    ],
                    "type": "string"
                  },
                  "content_hash": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "evidence_excerpt": {
                    "anyOf": [
                      {
                        "maxLength": 500,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "last_checked_at": {
                    "anyOf": [
                      {
                        "format": "date-time",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "last_verified_at": {
                    "anyOf": [
                      {
                        "format": "date-time",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "source_url": {
                    "format": "uri",
                    "type": "string"
                  }
                },
                "required": [
                  "confidence",
                  "source_url",
                  "evidence_excerpt",
                  "content_hash",
                  "last_checked_at",
                  "last_verified_at"
                ],
                "type": "object"
              },
              "registration_url": {
                "anyOf": [
                  {
                    "format": "uri",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "requires_registration": {
                "default": false,
                "type": "boolean"
              },
              "reward": {
                "additionalProperties": false,
                "properties": {
                  "hkd_per_mile": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "points_per_hkd": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "rate": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "type": {
                    "enum": [
                      "cash_rebate",
                      "points",
                      "miles"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "rate",
                  "points_per_hkd",
                  "hkd_per_mile"
                ],
                "type": "object"
              },
              "rule_id": {
                "$ref": "#/definitions/Card/properties/card_id"
              },
              "tier": {
                "anyOf": [
                  {
                    "additionalProperties": false,
                    "properties": {
                      "max_spend": {
                        "anyOf": [
                          {
                            "exclusiveMinimum": 0,
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "min_spend": {
                        "minimum": 0,
                        "type": "number"
                      },
                      "period": {
                        "enum": [
                          "transaction",
                          "month",
                          "quarter",
                          "year"
                        ],
                        "type": "string"
                      }
                    },
                    "required": [
                      "min_spend",
                      "max_spend",
                      "period"
                    ],
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "rule_id",
              "label",
              "match",
              "reward",
              "tier",
              "cap",
              "registration_url",
              "effective_from",
              "effective_to",
              "provenance"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "sources": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "etag": {
                "default": null,
                "type": [
                  "string",
                  "null"
                ]
              },
              "last_modified": {
                "default": null,
                "type": [
                  "string",
                  "null"
                ]
              },
              "note": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "purpose": {
                "enum": [
                  "scheme",
                  "programme_base",
                  "merchant_list",
                  "card_terms",
                  "kfs",
                  "card_index",
                  "product_page"
                ],
                "type": "string"
              },
              "url": {
                "format": "uri",
                "type": "string"
              }
            },
            "required": [
              "url",
              "purpose",
              "note"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "card_id",
        "card_name",
        "card_name_zh",
        "issuer",
        "network",
        "annual_fee",
        "annual_fee_waiver_note",
        "fx_fee_rate",
        "eligibility",
        "sources",
        "rewards",
        "provenance"
      ],
      "type": "object"
    }
  }
}
